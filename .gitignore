# Environment variables - NEVER commit
.env
.env.local
.env.*.local
.env.production.local

# But DO commit client/.env and client/.env.production (no secrets)
!client/.env
!client/.env.production

# Security: Always ignore server/.env (contains secrets)
server/.env

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build directories
dist/
dist-ssr/
build/
*.local

# IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
.DS_Store

# Uploads and temporary files
server/uploads/*
!server/uploads/.gitkeep

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Dependencies lock files (optional - uncomment if you want to commit)
# package-lock.json
# yarn.lock
